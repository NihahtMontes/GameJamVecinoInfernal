--- !u!114 &2929546038984166865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1624667929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7a8b9030f3a29c44a2a9b772c33e7ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  dialogueBlocks:
  - id: 0
    lines:
    - text: Tres horas manejando hasta el medio de la nada. Por supuesto.
      blockPlayer: 1
    - text: "Cosas raras en la casa del l\xFAnatico ese. Agh pero que m\xE1s da,
        no seas tonto Zack. \xBFQu\xE9 esperaba? Una tarde divertida."
      blockPlayer: 1
    - text: No hay nadie. La puerta... abierta. Perfecto.
      blockPlayer: 1
    - text: "Que conste que entr\xE9 porque era necesario."
      blockPlayer: 1
  - id: 1
    lines:
    - text: "Pinos. Muchos pinos. No me gustan los pinos desde que me call\xF3 una
        pi\xF1a en la cabeza."
      blockPlayer: 0
    - text: "\xBFQui\xE9n planta tantos pinos? Un viejo no cuerdo, claro."
      blockPlayer: 0
    - text: "Oj\xE1la solo sea que se convirtio en viejo senil. Pero no lo llevar\xE9
        al Asilo de ancionas."
      blockPlayer: 0
  - id: 2
    lines:
    - text: "Ah\xED est\xE1."
      blockPlayer: 1
    - text: Grande. Silenciosa.
      blockPlayer: 1
    - text: "\xBFHay alguien ah\xED dentro...?"
      blockPlayer: 1
    - text: ...Supongo que voy a tener que entrar para averiguarlo.
      blockPlayer: 1
  dialoguePanel: {fileID: 953810710}
  dialogueText: {fileID: 1231113219}
  dialogueMark: {fileID: 1811033293}
  playerScript: {fileID: 2929546038984166863}
  autoStart: 1
  autoStartId: 0
  charDelay: 0.035
